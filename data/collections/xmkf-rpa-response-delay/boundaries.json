{
  "lookLegend": [
    { "id": "realtime", "label": "实时" },
    { "id": "delayed", "label": "终态延迟" },
    { "id": "waiting", "label": "中间态延迟" }
  ],
  "groups": [
    {
      "id": "realtime",
      "title": "实时通道（不延迟）",
      "note": "状态一落库立即发生",
      "rows": [
        {
          "channel": "DB status / stepRunout",
          "afterComplete": "立即写入（含 WAITING）",
          "afterDue": "—",
          "timing": "realtime"
        },
        {
          "channel": "Dashboard Subscription / 监控页",
          "afterComplete": "立即更新（含 waiting）",
          "afterDue": "—",
          "timing": "realtime"
        },
        {
          "channel": "WebhookEndpoint 全部事件",
          "afterComplete": "立即推送（含 started / completed）",
          "afterDue": "—",
          "timing": "realtime"
        }
      ]
    },
    {
      "id": "delayed",
      "title": "终态延迟（对外 API）",
      "note": "responseDelayConfig.enabled + delaySeconds；仅 success/failed/aborted",
      "rows": [
        {
          "channel": "OpenAPI sync HTTP",
          "afterComplete": "连接挂起等待",
          "afterDue": "返回完整结果",
          "timing": "delayed"
        },
        {
          "channel": "callbackUrl / notifyUrl（终态）",
          "afterComplete": "不调用",
          "afterDue": "POST 回调并标记 resultDeliveredAt",
          "timing": "delayed"
        },
        {
          "channel": "GET /api/v1/tasks/:taskId",
          "afterComplete": "resultPending=true，隐藏 stepRunout",
          "afterDue": "返回完整结果",
          "timing": "delayed"
        }
      ]
    },
    {
      "id": "waiting",
      "title": "中间态延迟（run.waiting）",
      "note": "waitingEnabled + waitingDelaySeconds；与终态开关独立",
      "rows": [
        {
          "channel": "OpenAPI sync（waiting）",
          "afterComplete": "落库 WAITING 但未投递 → 继续挂起",
          "afterDue": "publish sync:run → status=waiting",
          "timing": "waiting"
        },
        {
          "channel": "callbackUrl run.waiting",
          "afterComplete": "不调用",
          "afterDue": "deliver-waiting-notify POST",
          "timing": "waiting"
        },
        {
          "channel": "同任务 submit / signal",
          "afterComplete": "409 FAIL_STILL_PENDING（延时窗口内）",
          "afterDue": "窗口结束后允许 submit",
          "timing": "waiting"
        }
      ]
    }
  ]
}
